// Level 5: Gradient descent
// Find the line y = w*x + b that best fits the data by repeatedly nudging
// w and b downhill on the loss surface. The true answer is w = 2, b = 1.

let xs = [1, 2, 3, 4, 5];
let ys = [3, 5, 7, 9, 11];
let n = len(xs);

let w = 0;       // start from a bad guess
let b = 0;
let lr = 0.02;   // learning rate: the size of each downhill step
let loss = 0;

for (let epoch = 0; epoch < 300; epoch += 1) {
  let dw = 0;
  let db = 0;
  loss = 0;
  for (let i = 0; i < n; i += 1) {
    let err = (w * xs[i] + b) - ys[i];   // prediction minus truth
    loss += err * err / n;               // mean squared error
    dw += 2 * err * xs[i] / n;           // dLoss/dw
    db += 2 * err / n;                   // dLoss/db
  }
  w -= lr * dw;
  b -= lr * db;
  plot("loss", epoch, loss);
}

print("w =", w, " b =", b, " loss =", loss);
