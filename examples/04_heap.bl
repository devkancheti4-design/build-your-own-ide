// Level 4: Pointers and the heap
// An array doesn't fit in 64 bits, so it lives on the heap. A variable
// holds only its address: a reference. Watch the Heap panel as items swap.

let data = [5, 1, 4, 2, 8];
let alias = data;   // copies the reference, not the array!

fn bubble_sort(a) {
  let n = len(a);
  for (let i = 0; i < n - 1; i += 1) {
    for (let j = 0; j < n - 1 - i; j += 1) {
      if (a[j] > a[j + 1]) {
        let tmp = a[j];
        a[j] = a[j + 1];
        a[j + 1] = tmp;
      }
    }
  }
}

bubble_sort(data);
print("data: ", data);
print("alias:", alias);   // the same array, so it's sorted too
