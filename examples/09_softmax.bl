// Level 9: Softmax and cross-entropy
// Softmax turns raw scores (logits) into probabilities. Cross-entropy
// measures how surprised the model is by the right answer.

fn softmax(z) {
  // Subtract the max first. exp(1000) overflows to Infinity (level 2!), but
  // softmax(z) equals softmax(z - c) for any c, so this costs nothing.
  let m = z[0];
  for (let i = 1; i < len(z); i += 1) {
    m = max(m, z[i]);
  }
  let p = array(len(z), 0);
  let total = 0;
  for (let i = 0; i < len(z); i += 1) {
    p[i] = exp(z[i] - m);
    total += p[i];
  }
  for (let i = 0; i < len(z); i += 1) {
    p[i] /= total;
  }
  return p;
}

print("softmax([1, 2, 3])          =", softmax([1, 2, 3]));
print("softmax([1000, 1001, 1002]) =", softmax([1000, 1001, 1002]));

// Train a linear classifier on three classes of 2D points.
let X = [[0, 1], [0.5, 1.5], [1, 1], [3, 0], [3.5, 0.5], [4, 0], [2, 3], [2.5, 3.5], [1.5, 3.5]];
let Y = [0, 0, 0, 1, 1, 1, 2, 2, 2];
let C = 3;
let W = [[0, 0], [0, 0], [0, 0]];   // one row of weights per class
let B = [0, 0, 0];
let lr = 0.1;
let loss = 0;

for (let epoch = 0; epoch < 200; epoch += 1) {
  loss = 0;
  for (let i = 0; i < len(X); i += 1) {
    let x = X[i];
    let z = array(C, 0);
    for (let c = 0; c < C; c += 1) {
      z[c] = W[c][0] * x[0] + W[c][1] * x[1] + B[c];
    }
    let p = softmax(z);
    loss -= log(p[Y[i]]) / len(X);   // cross-entropy
    for (let c = 0; c < C; c += 1) {
      // The famous clean gradient: dLoss/dz = p - onehot(y).
      let g = p[c];
      if (c == Y[i]) {
        g -= 1;
      }
      W[c][0] -= lr * g * x[0];
      W[c][1] -= lr * g * x[1];
      B[c] -= lr * g;
    }
  }
  plot("cross-entropy", epoch, loss);
}
print("final loss:", loss);
