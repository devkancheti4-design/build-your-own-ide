// Level 6: The perceptron (Rosenblatt, 1958)
// One artificial neuron: a weighted sum, then a hard threshold.
// It learns the AND function from four examples.

let inputs = [[0, 0], [0, 1], [1, 0], [1, 1]];
let targets = [0, 0, 0, 1];   // AND
let w = [0, 0];
let bias = 0;
let lr = 0.1;

fn predict(x) {
  let sum = w[0] * x[0] + w[1] * x[1] + bias;
  if (sum > 0) {
    return 1;
  }
  return 0;
}

let mistakes = 1;
let epoch = 0;
while (mistakes > 0 && epoch < 25) {
  mistakes = 0;
  for (let i = 0; i < 4; i += 1) {
    let error = targets[i] - predict(inputs[i]);
    if (error != 0) {
      w[0] += lr * error * inputs[i][0];
      w[1] += lr * error * inputs[i][1];
      bias += lr * error;
      mistakes += 1;
    }
  }
  plot("mistakes per epoch", epoch, mistakes);
  epoch += 1;
}

print("trained for", epoch, "epochs: w =", w, " bias =", bias);
for (let i = 0; i < 4; i += 1) {
  print(inputs[i], "->", predict(inputs[i]));
}
